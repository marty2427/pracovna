  "directions": [
    {
      "id": "shoda-podlaha",
      "nazev": "Shoda s podlahou",
      "deska": "#8A4A16",
      "podnoz": "#6E3A10",
      "detail": "#96521A",
      "odvozeno_z": [
        "podlaha_vlysy.base #83420F",
        "podlaha_vlysy.light #96521A"
      ],
      "proc": "Deska ve stejném teplém oranžovo-hnědém tónu jako vlysy. Stůl se opticky rozpustí v podlaze, roh přestane být 'kus nábytku' a místnost působí větší — což se u 211 cm dlouhého ramene v obýváku hodí.",
      "pozor": "Bez kontrastu proti podlaze může velká deska působit těžce. Vyvážit tenčí deskou (18-25 mm) nebo světlou a subtilní podnoží, ať to neroste do bloku.",
      "material_hint": "mořený dub v tónu podlahy, dýhovaná MDF, nebo lamino s dekorem teplého dubu"
    },
    {
      "id": "o-ton-tmavsi",
      "nazev": "O tón tmavší",
      "deska": "#54301A",
      "podnoz": "#1F2021",
      "detail": "#3A2011",
      "odvozeno_z": [
        "podlaha_vlysy.dark #723608 ztmaveno",
        "dub_bocnice #844F26"
      ],
      "proc": "Kouřový dub až ořech. Dost tmavý na to, aby byl stůl vlastní objekt, ale pořád ve stejné teplé dřevěné rodině jako podlaha. Naváže na černé rámy fotek a na židli.",
      "pozor": "V rohu bez přímého světla ztmavne ještě víc — počítat s LED podsvícením nebo lampou.",
      "material_hint": "mořený dub, ořechová dýha, lamino tmavý dub"
    },
    {
      "id": "o-ton-svetlejsi",
      "nazev": "O tón světlejší (jako stávající nábytek)",
      "deska": "#C69160",
      "podnoz": "#92613B",
      "detail": "#CEA280",
      "odvozeno_z": [
        "dub_deska #C69160",
        "dub_konferencak #CEA280",
        "dub_kontejner #92613B"
      ],
      "proc": "Přesně ten světlý dub, který v místnosti už je — konferenčák, kontejner, stávající stůl. Nejbezpečnější volba: pracovní a obývací zóna se spojí do jedné rodiny a stůl nebude působit jako cizí prvek.",
      "pozor": "Proti tmavší podlaze je světlá deska hodně vidět — a s ní každý kabel a nepořádek.",
      "material_hint": "světlý dub / jasan, dýha, lamino dekor světlý dub"
    },
    {
      "id": "kontrast-cerna",
      "nazev": "Kontrast — antracit / matná čerň",
      "deska": "#2B2C2E",
      "podnoz": "#1F2021",
      "detail": "#F0EAE6",
      "odvozeno_z": [
        "cerna_zidle #1F2021",
        "cerna_monitor #14110D",
        "cerna_ram_fotky #050200"
      ],
      "proc": "V místnosti už černá je — rámy fotek, židle, monitor, lampička. Stůl v antracitu se k nim přidá jako záměrný grafický prvek proti teplé podlaze.",
      "pozor": "Celá deska 211x70 v černé je hodně plochy v malém rohu. Lépe funguje jako podnož a boky s dřevěnou deskou než jako celý stůl.",
      "material_hint": "lamino/HPL antracit, komaxit RAL 9005 struktura, linoleum Forbo tmavě šedé"
    },
    {
      "id": "kov-drevo",
      "nazev": "Kov + dřevo",
      "deska": "#96521A",
      "podnoz": "#1F2021",
      "detail": "#C5B5A9",
      "odvozeno_z": [
        "podlaha_vlysy.light #96521A",
        "cerna_zidle #1F2021",
        "chrom_lampa #C5B5A9"
      ],
      "proc": "Nejsilnější vazba na to, co v místnosti je: černý ocelový rám navazuje na rámy fotek a židli, dřevěná deska na podlahu. Tenký rám nechá pod stolem prosvítat podlahu, takže stůl působí lehce — důležité, když zabírá celý roh.",
      "pozor": "Rám musí být subtilní (jekl 30x30 až 40x40). Silný profil sklouzne do dílenského vzhledu.",
      "material_hint": "masiv nebo dýha + jekl komaxit RAL 9005 / černá struktura"
    },
    {
      "id": "neutral",
      "nazev": "Neutrál v tónu stěn",
      "deska": "#D8C6B4",
      "podnoz": "#C9B7A9",
      "detail": "#BBA89C",
      "odvozeno_z": [
        "stena_celek.base #C9B7A9",
        "stena_zadni_svetla #E7C4A7",
        "polstar_bezovy #BBA89C"
      ],
      "proc": "Krémová v tónu stěn. Stůl ustoupí do pozadí a nechá vyniknout gauč, obraz a koberec. Dobrá volba, když nechceš, aby pracovní zóna dominovala obýváku.",
      "pozor": "Světlý povrch v pracovní zóně se rychle ušpiní — chce odolnou úpravu (lamino, HPL, linoleum).",
      "material_hint": "lamino krémová/kašmír, Forbo linoleum světlé, lakovaná MDF"
    },
    {
      "id": "akcent-gauc-obraz",
      "nazev": "Bonus: akcent v tónu gauče nebo obrazu",
      "deska": "#C69160",
      "podnoz": "#1F2021",
      "detail": "#043A53",
      "detail2": "#C58114",
      "odvozeno_z": [
        "gauc_celek.base #043A53",
        "obraz_1 #C58114",
        "koberec_zluta #BB8A3E"
      ],
      "proc": "Dřevěný stůl, ale čela zásuvek nebo zadní panel v petroleji gauče nebo v hořčicové z obrazu a koberce. Malá plocha, velký efekt — stůl se s místností propojí barvou, ne materiálem.",
      "pozor": "Jen jeden akcent, ne oba. Dvě barvy navíc jsou v tomhle rohu už moc.",
      "material_hint": "lakovaná MDF v odstínu namíchaném na vzorek, nebo lamino v nejbližším dekoru"
    }
